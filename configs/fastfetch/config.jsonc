{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 3
    },
    "color": {
      "1": "#88C0D0",
      "2": "#81A1C1",
      "3": "#8FBCBB"
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "title": "#88C0D0",
      "keys": "#81A1C1",
      "output": "#D8DEE9",
      "separator": "#4C566A"
    },
    "key": {
      "width": 10,
      "type": "string"
    }
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },

    "break",

    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "display",
      "key": "Display"
    },

    "break",

    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk"
    },

    "break",
    "colors"
  ]
}
